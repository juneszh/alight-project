{
    "name": "juneszh/alight-project",
    "description": "Alight Project is a project template with Alight framework.",
    "type": "project",
    "license": "MIT",
    "keywords": [
        "php",
        "lightweight",
        "framework",
        "restful",
        "fast-route",
        "medoo",
        "simplecache",
        "psr-16",
        "monolog",
        "whoops",
        "job-scheduler"
    ],
    "authors": [
        {
            "name": "June So",
            "email": "june@alight.cc"
        }
    ],
    "autoload": {
        "psr-4": {
            "ctr\\": "app/controller",
            "job\\": "app/job",
            "mod\\": "app/model",
            "svc\\": "app/service"
        }
    },
    "require": {
        "php": ">=8.3",
        "juneszh/alight": "^3.0"
    },
    "scripts": {
        "post-root-package-install": "mv config/app.example.php config/app.php",
        "post-update-cmd": "@php tools/clear-route-cache.php",
        "lint": "@php tools/lint.php",
        "analyse": "phpstan analyse --no-progress --debug",
        "check": [
            "@composer validate --strict --no-check-publish --no-check-lock",
            "@lint",
            "@analyse"
        ],
        "admin-install": "Alight\\Admin::install",
        "admin-download": "Alight\\Admin::download",
        "admin-build": [
            "cd vendor/juneszh/alight-admin/resource && npm install && npm run tinymce && npm run build",
            "Alight\\Admin::publish"
        ]
    },
    "config": {
        "optimize-autoloader": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "phpstan/phpstan": "^2.1"
    }
}
